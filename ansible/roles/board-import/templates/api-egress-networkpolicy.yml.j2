apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: board-import-api-egress
  namespace: {{ NAMESPACE }}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: board-import-api
  policyTypes:
    - Egress
  egress:
    - ports:
        - port: 53
          protocol: UDP
        - port: 53
          protocol: TCP

    # MongoDB is outside the cluster and has no fixed address range.
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0
      ports:
        - port: 27017
          protocol: TCP

    # Session Valkey with Sentinel
    - to:
        - podSelector:
            matchLabels:
              app.kubernetes.io/instance: session
      ports:
        - port: 6379
          protocol: TCP
        - port: 26379
          protocol: TCP

    - to:
        - podSelector:
            matchLabels:
              app.kubernetes.io/component: rabbitmq
      ports:
        - port: 5672
          protocol: TCP
