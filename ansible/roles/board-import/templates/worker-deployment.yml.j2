apiVersion: apps/v1
kind: Deployment
metadata:
  name: board-import-worker-deployment
  namespace: {{ NAMESPACE }}
{% if ANNOTATIONS is defined and ANNOTATIONS|bool %}
  annotations:
{% if RELOADER is defined and RELOADER|bool %}
    reloader.stakater.com/auto: "true"
{% endif %}
{% endif %}
  labels:
    app: board-import-worker
    app.kubernetes.io/part-of: schulcloud-verbund
    app.kubernetes.io/version: {{ SCHULCLOUD_SERVER_IMAGE_TAG }}
    app.kubernetes.io/name: board-import-worker
    app.kubernetes.io/component: server
    app.kubernetes.io/managed-by: ansible
    git.branch: {{ SCHULCLOUD_SERVER_BRANCH_NAME }}
    git.repo: {{ SCHULCLOUD_SERVER_REPO_NAME }}
spec:
{# KEDA sets the replicas when it scales the worker. #}
{% if not (KEDA_ENABLED is defined and KEDA_ENABLED|bool and SCALED_BOARD_IMPORT_WORKER_ENABLED is defined and SCALED_BOARD_IMPORT_WORKER_ENABLED|bool) %}
  replicas: {{ BOARD_IMPORT_WORKER_REPLICAS }}
{% endif %}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
  revisionHistoryLimit: 4
  paused: false
  selector:
    matchLabels:
      app: board-import-worker
  template:
    metadata:
      labels:
        app: board-import-worker
        app.kubernetes.io/part-of: schulcloud-verbund
        app.kubernetes.io/version: {{ SCHULCLOUD_SERVER_IMAGE_TAG }}
        app.kubernetes.io/name: board-import-worker
        app.kubernetes.io/component: server
        app.kubernetes.io/managed-by: ansible
        git.branch: {{ SCHULCLOUD_SERVER_BRANCH_NAME }}
        git.repo: {{ SCHULCLOUD_SERVER_REPO_NAME }}
    spec:
      securityContext:
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        runAsNonRoot: true
      os:
        name: linux
      containers:
      - name: board-import-worker
        image: {{ SCHULCLOUD_SERVER_IMAGE }}:{{ SCHULCLOUD_SERVER_IMAGE_TAG }}
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 4456
          name: http-health
          protocol: TCP
        env:
        - name: NODE_OPTIONS
          value: "--max-old-space-size={{ ((BOARD_IMPORT_WORKER_MEMORY_LIMITS | regex_replace('Gi', '')|int * 1024 * 0.8)|int) }}"
{# Only this key of the server secret. The import API must not get the private key. #}
        - name: JWT_PRIVATE_KEY
          valueFrom:
            secretKeyRef:
              name: api-secret
              key: JWT_PRIVATE_KEY
        envFrom:
        - configMapRef:
            name: board-import-worker-configmap
        - secretRef:
            name: board-import-secret
        - secretRef:
            name: session-valkey-password
        command: ['/nodejs/bin/node', 'dist/apps/server/apps/board-import-worker.app']
        readinessProbe:
          httpGet:
            path: /internal/health
            port: 4456
          timeoutSeconds: 4
          failureThreshold: 3
          periodSeconds: 5
        livenessProbe:
          httpGet:
            path: /internal/health
            port: 4456
          timeoutSeconds: 4
          failureThreshold: 3
          periodSeconds: 15
        startupProbe:
          httpGet:
            path: /internal/health
            port: 4456
          timeoutSeconds: 4
          failureThreshold: 36
          periodSeconds: 5
        resources:
          limits:
            cpu: {{ BOARD_IMPORT_WORKER_CPU_LIMITS }}
            memory: {{ BOARD_IMPORT_WORKER_MEMORY_LIMITS }}
          requests:
            cpu: {{ BOARD_IMPORT_WORKER_CPU_REQUESTS }}
            memory: {{ BOARD_IMPORT_WORKER_MEMORY_REQUESTS }}
{% if AFFINITY_ENABLE is defined and AFFINITY_ENABLE|bool %}
      affinity:
        podAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 9
            podAffinityTerm:
              labelSelector:
                matchExpressions:
                - key: app.kubernetes.io/part-of
                  operator: In
                  values:
                  - schulcloud-verbund
              topologyKey: "kubernetes.io/hostname"
              namespaceSelector: {}
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
{% if ANIT_AFFINITY_NODEPOOL_ENABLE is defined and ANIT_AFFINITY_NODEPOOL_ENABLE|bool %}
          - weight: 10
            podAffinityTerm:
              labelSelector:
                matchExpressions:
                - key: app.kubernetes.io/name
                  operator: In
                  values:
                  - board-import-worker
              topologyKey: {{ ANIT_AFFINITY_NODEPOOL_TOPOLOGY_KEY }}
{% endif %}
          - weight: 20
            podAffinityTerm:
              labelSelector:
                matchExpressions:
                - key: app.kubernetes.io/name
                  operator: In
                  values:
                  - board-import-worker
              topologyKey: "topology.kubernetes.io/zone"
{% endif %}
