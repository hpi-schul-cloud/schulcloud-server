apiVersion: v1
kind: ConfigMap
metadata:
  name: board-import-api-configmap
  namespace: {{ NAMESPACE }}
  labels:
    app: board-import-api
data:
  NEST_LOG_LEVEL: "info"
  EXIT_ON_ERROR: "true"
  JWT_PUBLIC_KEY: "{{ JWT_PUBLIC_KEY }}"
  SC_DOMAIN: "{{ DOMAIN }}"
  BOARD_IMPORT_TASKCARDS_BOARD_HOSTS: "{{ BOARD_IMPORT_TASKCARDS_BOARD_HOSTS | default('taskcards.de,*.taskcards.de,taskcards.app,*.taskcards.app') }}"
  FEATURE_BOARD_IMPORT_ENABLED: "{{ FEATURE_BOARD_IMPORT_ENABLED | default('false') }}"
  SESSION_VALKEY__MODE: "{{ SESSION_VALKEY__MODE }}"
  SESSION_VALKEY__SENTINEL_NAME: "{{ SESSION_VALKEY__SENTINEL_NAME }}"
  SESSION_VALKEY__SENTINEL_SERVICE_NAME: "{{ SESSION_VALKEY__SENTINEL_SERVICE_NAME }}"
